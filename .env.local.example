# ──────────────────────────────────────────────────────────────
#  raw_App 환경변수 예제 — 실제 값은 .env.local 에 복사 후 채워넣으세요.
#  (.env.local 은 .gitignore 로 추적 제외. 이 .example 만 커밋됩니다)
# ──────────────────────────────────────────────────────────────

# ── Crosstarget Open API (정산·인사이트 read-only) ──────────────
# 발급: https://manage2.crosstarget.co.kr → 우측 상단 프로필 → API 토큰 → 새 토큰 발급
#  - 이름 예: raw_App-prod / raw_App-preview (환경별 분리 권장)
#  - 만료일: 1년 권장 (무기한은 회전 추적 어려움)
#  - 발급 즉시 복사 (재조회 불가)
# 미설정 시: 정산 페이지 우측 badge 가 'Open API 토큰 미설정'(amber) 으로 표시되며,
#            페이지 동작 자체에는 영향 없음 (Open API 기능만 비활성).
OPEN_API_TOKEN=

# 선택 — 기본값(production endpoint)과 동일하므로 평소엔 생략.
# staging endpoint 테스트 시에만 override.
# OPEN_API_BASE_URL=https://manage2.crosstarget.co.kr/api/v1

# ── Motiv API (기존 캠페인/stats 데이터) ────────────────────────
# 미설정 시 Motiv 기반 정산/캠페인 데이터가 비어 보일 수 있음.
MOTIV_API_TOKEN=
