# ──────────────────────────────────────────────────────────────
#  raw_App 환경변수 예제 — 실제 값은 .env.local 에 복사 후 채워넣으세요.
#  (.env.local 은 .gitignore 로 추적 제외. 이 .example 만 커밋됩니다)
# ──────────────────────────────────────────────────────────────

# ── Crosstarget Open API (정산·인사이트 read-only) ──────────────
# 발급: https://manage2.crosstarget.co.kr → 우측 상단 프로필 → API 토큰 → 새 토큰 발급
#  - 이름 예: raw_App-prod / raw_App-preview (환경별 분리 권장)
#  - 만료일: 1년 권장 (무기한은 회전 추적 어려움)
#  - 발급 즉시 복사 (재조회 불가)
# 미설정 시: 정산 페이지 우측 badge 가 'Open API 토큰 미설정'(amber) 으로 표시되며,
#            페이지 동작 자체에는 영향 없음 (Open API 기능만 비활성).
OPEN_API_TOKEN=

# 선택 — 기본값(production endpoint)과 동일하므로 평소엔 생략.
# staging endpoint 테스트 시에만 override.
# OPEN_API_BASE_URL=https://manage2.crosstarget.co.kr/api/v1

# ── Motiv API (기존 캠페인/stats 데이터) ────────────────────────
# 미설정 시 Motiv 기반 정산/캠페인 데이터가 비어 보일 수 있음.
MOTIV_API_TOKEN=

# (선택) Open API 매체비에서 대행료 파생 시 기본 대행 요율 (소수). 예: 0.15 = 15%.
# 미설정 시 대행료 0 (DMP data_fee 는 광고그룹 감지로 자동 파생). 캠페인별 정확 요율은
# motiv_assignments.customAgencyFeeRate 로 override. 자세한 내용 docs/OPEN_API_ADVERTISER_AGENCY_COST_MAPPING.md
# OPEN_API_DEFAULT_AGENCY_FEE_RATE=0.15

# ── Publica 데일리 리포트 에이전트 ──────────────────────────────
# 매일 도착하는 Publica 리포트 3종(basic/publisher/error)을 읽어 이상 징후를
# 탐지하고 결과를 메일로 보냅니다. 설정 절차: docs/PUBLICA_DAILY_REPORT_AGENT.md
#
# [중요] 개인 메일함을 직접 열지 않습니다. 개인 계정(예: dk.lee@motiv-i.com)에
# "Publica 발신자 → 봇 주소로 전달" 필터를 걸고, 아래에는 **봇 메일함** 자격증명만
# 넣습니다. 필터를 끄면 즉시 차단되고, 개인 메일은 노출되지 않습니다.

# 봇 메일함 IMAP (읽기 전용으로만 접근 — 메일 플래그를 변경하지 않음)
PUBLICA_IMAP_USER=
PUBLICA_IMAP_PASSWORD=
# 선택 — 기본값과 같으면 생략
# PUBLICA_IMAP_HOST=imap.gmail.com
# PUBLICA_IMAP_PORT=993
# PUBLICA_IMAP_MAILBOX=INBOX

# 분석 결과를 받을 주소 (미설정 시 ALERT_RECIPIENT 로 fallback)
PUBLICA_ALERT_RECIPIENT=

# 선택 — 조회 조건
# PUBLICA_SENDER_FILTER=publica   # 발신자 부분 일치 (기본 publica)
# PUBLICA_LOOKBACK_HOURS=26       # 조회 구간 (기본 26시간)
# PUBLICA_MAX_MESSAGES=20         # 1회 처리 상한 (기본 20)

# 선택 — 발송 정책
# PUBLICA_ALERT_ON_MISSING=false  # 리포트 미수신 시 알림 끄기 (기본 true)
# PUBLICA_ALWAYS_SEND=true        # 이상 없어도 매일 발송 (기본 false)

# 선택 — 탐지 임계값 (기본값으로 운영하다 오탐/미탐 보이면 조정)
# PUBLICA_RENDER_RATE_FLOOR=0.8          # 렌더율 하한
# PUBLICA_TIMEOUT_RATE_CEILING=0.01      # 타임아웃율 상한
# PUBLICA_INTEGRATION_SHARE_WARN=0.05    # 연동성 에러 비중 주의 임계
# PUBLICA_INTEGRATION_SHARE_CRITICAL=0.2 # 연동성 에러 비중 심각 임계
# PUBLICA_METRIC_DROP_RATIO=0.3          # 최신일 지표 급락 임계
# PUBLICA_MAX_ANOMALIES=100              # 메일 1통당 최대 항목

# 선택 — LLM 보조 요약 (기본 비활성. 규칙 탐지만으로도 동작함)
# PUBLICA_LLM_ENABLED=true
# ANTHROPIC_API_KEY=
# PUBLICA_LLM_MODEL=claude-opus-5
